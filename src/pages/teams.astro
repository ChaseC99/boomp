---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import teamsIllustration from '../assets/teams.png';
import Icon from '../components/Icon';
import TeamBadge from '../components/TeamBadge';
import { getTournamentData } from '../data/tournament';
const { teams } = await getTournamentData();
---

<Layout title="Teams" active="teams">
  <div class="wrap interior-page">
    <header class="page-heading">
      <div>
        <h1>Teams</h1>
        <p class="page-subtitle">
          {teams.length} teams ·{' '}
          {teams.reduce((count, team) => count + team.players.length, 0)}{' '}
          players
        </p>
      </div>
      <Image
        src={teamsIllustration}
        alt=""
        width={134}
        height={134}
        widths={[134, 268, 402]}
        sizes="(min-width: 600px) 134px, 112px"
        loading="eager"
      />
    </header>
    <ol class="team-lineup">
      {teams.map((team) => (
        <li class:list={['info-card', 'roster-card', team.color]}>
          <div class="roster-heading">
            <TeamBadge team={team} />
            <div>
              <h2>{team.name}</h2>
              <p>{team.players.length} players</p>
            </div>
          </div>
          <ul class="roster-players">
            {team.players.map((player) => (
              <li>{player}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <aside class="waitlist-note">
      <Icon name="info" size={20} />
      <div>
        <h2>If you're not listed, you're still welcome to come!</h2>
        <p>You can sub in or join a team.</p>
      </div>
    </aside>
  </div>
</Layout>
