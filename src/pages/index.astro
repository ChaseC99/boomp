---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon';
import { event, getTournamentData } from '../data/tournament';
const { teams } = await getTournamentData();
const details = [
  {
    icon: 'calendar',
    label: 'Date',
    value: event.shortDate,
    note: 'Weather permitting',
  },
  {
    icon: 'clock',
    label: 'Time',
    value: event.time,
    note: 'Games begin at 1pm',
  },
  {
    icon: 'pin',
    label: 'Location',
    value: event.location,
    href: event.locationUrl,
  },
  {
    icon: 'ball',
    label: 'Volleyball',
    value: event.format,
    note: 'Groups shuffle every round, points stay with your team',
  },
  {
    icon: 'ghost',
    label: 'Dress code',
    value: 'Dress to impress — bring your spookiest fit',
    note: 'Scare the other team off the court',
  },
] as const;
---

<Layout active="info">
  <div class="wrap info-page">
    <header class="event-intro">
      <h1>{event.name}</h1>
      <img
        src="/images/halloween-volleyball.png"
        alt="A pumpkin and ghost playing volleyball."
        width="1280"
        height="1280"
        fetchpriority="high"
      />
    </header>
    <section class="info-card" aria-label="Event details">
      <dl class="event-details">
        {details.map((item) => (
          <div class="event-row">
            <dt>
              <Icon name={item.icon} size={21} />
              <span>{item.label}</span>
            </dt>
            <dd>
              {'href' in item ? (
                <a
                  class="location-link"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.value}
                </a>
              ) : (
                <span>{item.value}</span>
              )}
              {'note' in item && <small>{item.note}</small>}
            </dd>
          </div>
        ))}
      </dl>
    </section>
    <section class="weather-card" aria-labelledby="park-heading">
      <div class="weather-top">
        <div>
          <h2 id="park-heading">Plan for the park</h2>
          <p>Check the forecast before heading out.</p>
        </div>
        <Icon name="cloud" size={44} />
      </div>
      <h3 class="packing-heading">What to bring</h3>
      <ul class="packing-list">
        {[
          'Costume & layers',
          'Water & snacks',
          'Sunscreen & sunglasses',
          'Picnic blanket',
        ].map((item) => (
          <li>
            <Icon name="check" size={16} />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="info-section" aria-labelledby="format-heading">
      <div class="section-heading">
        <Icon name="ball" size={21} />
        <h2 id="format-heading">How the day works</h2>
      </div>
      <ol class="format-steps info-card">
        <li>
          <span class="step-number" aria-hidden="true">
            01
          </span>
          <div>
            <h3>Join your team</h3>
            <p>3 teams of 8, the same all day.</p>
          </div>
        </li>
        <li>
          <span class="step-number" aria-hidden="true">
            02
          </span>
          <div>
            <h3>Shuffle into groups</h3>
            <p>
              Every round, your team splits into two new groups of 4, so you'll
              play with different people throughout the day.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number" aria-hidden="true">
            03
          </span>
          <div>
            <h3>Play 4v4</h3>
            <p>
              Groups face off across 3 courts. Every win earns points for your
              whole team.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number" aria-hidden="true">
            04
          </span>
          <div>
            <h3>Most points wins</h3>
            <p>Ties go to the best dressed team.</p>
          </div>
        </li>
      </ol>
      <p class="section-note">
        {teams.length} teams ·{' '}
        {teams.reduce((count, team) => count + team.players.length, 0)} players
        · 3 courts
      </p>
    </section>

    <section class="info-section" aria-labelledby="prizes-heading">
      <div class="section-heading">
        <Icon name="trophy" size={21} />
        <h2 id="prizes-heading">Up for grabs</h2>
      </div>
      <div class="info-card prize-list">
        <div>
          <span class="prize-icon">
            <Icon name="trophy" size={22} />
          </span>
          <div>
            <h3>Winning team</h3>
            <p>
              A prize, bragging rights, and a full year of being insufferable.
            </p>
          </div>
        </div>
        <div>
          <span class="prize-icon">
            <Icon name="ghost" size={22} />
          </span>
          <div>
            <h3>Best costume</h3>
            <p>
              Individual or duo, decided by vote. Group costumes encouraged!
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
