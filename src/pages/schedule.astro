---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import scheduleIllustration from '../assets/schedule.png';
import Schedule from '../components/Schedule';
import { getTournamentData } from '../data/tournament';
const data = await getTournamentData();
---

<Layout title="Schedule" active="schedule">
  <div class="wrap interior-page schedule-page">
    <Schedule {...data} client:load>
      <Image
        src={scheduleIllustration}
        alt=""
        width={112}
        height={112}
        widths={[96, 112, 192, 224, 336]}
        sizes="(min-width: 600px) 112px, 96px"
        loading="eager"
      />
    </Schedule>
    {data.matches.length > 0 && (
      <noscript>
        <p class="noscript-notice">
          Enable JavaScript to search teams and filter matches. The match
          schedule is listed above.
        </p>
      </noscript>
    )}
  </div>
</Layout>
