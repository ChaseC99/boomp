---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import scheduleIllustration from '../assets/schedule.png';
import Schedule from '../components/Schedule';
import { getTournamentData } from '../data/tournament';
// Unlisted preview of the full schedule: nothing links here, and search
// engines are asked to skip it.
const data = await getTournamentData();
---

<Layout title="Schedule" active="schedule" noindex>
  <div class="wrap interior-page">
    <header class="page-heading">
      <h1>Schedule</h1>
      <Image
        src={scheduleIllustration}
        alt=""
        width={134}
        height={134}
        widths={[134, 268, 402]}
        sizes="(min-width: 600px) 134px, 112px"
        loading="eager"
      />
    </header>
    <Schedule {...data} client:load />
    {data.matches.length > 0 && (
      <noscript>
        <p class="noscript-notice">
          Enable JavaScript to search teams and filter matches. The match
          schedule is listed above.
        </p>
      </noscript>
    )}
  </div>
</Layout>
