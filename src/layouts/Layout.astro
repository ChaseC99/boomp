---
import '../styles/global.css';
import Icon from '../components/Icon';
import { event } from '../data/tournament';
interface Props {
  title?: string;
  active: 'info' | 'teams' | 'schedule' | 'standings';
}
const { title, active } = Astro.props;
const links = [
  { id: 'info', href: '/', label: 'Info', icon: 'info' },
  { id: 'teams', href: '/teams/', label: 'Teams', icon: 'ghost' },
  { id: 'schedule', href: '/schedule/', label: 'Schedule', icon: 'ball' },
  { id: 'standings', href: '/standings/', label: 'Standings', icon: 'trophy' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#faf8f4" />
    <meta name="application-name" content={event.name} />
    <meta name="apple-mobile-web-app-title" content="BOOmp" />
    <title>{title ? `${title} · ${event.name}` : event.name}</title>
    <meta
      name="description"
      content={`Event information, teams, schedule, and standings for ${event.name} ${event.date} at ${event.time}. ${event.location}.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png?v=2"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <main id="main">
      <slot />
    </main>
    <nav class="tab-bar" aria-label="Main navigation">
      <div class="tab-bar-inner">
        {links.map((link) => (
          <a
            class:list={['tab-link', { active: active === link.id }]}
            href={link.href}
            aria-current={active === link.id ? 'page' : undefined}
          >
            <span class="tab-icon">
              <Icon name={link.icon} size={24} />
            </span>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </nav>
  </body>
</html>
